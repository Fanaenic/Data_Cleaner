# ── DataCleaner — пример переменных окружения ─────────────────────────────
# Скопируйте в .env и заполните реальными значениями:
#   cp .env.example .env

# ── Безопасность ─────────────────────────────────────────────────────────
# Генерация: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-secret-key-minimum-32-chars

# ── База данных ──────────────────────────────────────────────────────────
# SQLite (локальная разработка):
DATABASE_URL=sqlite:////data/datacleaner.db

# ── Администратор по умолчанию ────────────────────────────────────────────
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_USERNAME=admin
ADMIN_NAME=Administrator
ADMIN_PASSWORD=change-me-strong-password

# ── MinIO / S3 ────────────────────────────────────────────────────────────
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change-me-minio-password
S3_BUCKET=datacleaner-images

# ── Frontend ──────────────────────────────────────────────────────────────
REACT_APP_API_URL=http://localhost/api
REACT_APP_SITE_URL=http://localhost

# ── SEO ──────────────────────────────────────────────────────────────────
SITE_URL=http://localhost

# ── Сторонний API геолокации (опционально) ────────────────────────────────
# Бесплатный ключ: https://members.ip-api.com/
IPAPI_KEY=
IPAPI_TIMEOUT=5
IPAPI_MAX_RETRIES=3
IPAPI_RETRY_DELAY=1
